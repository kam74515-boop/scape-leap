[Unit]
Description=ScapeLeap PostgreSQL API
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
EnvironmentFile=/etc/scapeleap/production.env
User=karld74515_gmail_com
WorkingDirectory=/srv/scapeleap/source/formscape-app
ExecStart=/usr/local/bin/node scripts/mock-api.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/scapeleap/data

[Install]
WantedBy=multi-user.target
